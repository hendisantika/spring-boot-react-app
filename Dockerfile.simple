# Simple Dockerfile - Build locally, then containerize
# Usage:
#   1. Build locally: ./mvnw clean package -DskipTests
#   2. Build image: docker build -f Dockerfile.simple -t spring-boot-react-app .

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Create a non-root user
RUN addgroup -S spring && adduser -S spring -G spring

# Copy the pre-built JAR file
COPY target/*.jar app.jar

# Change ownership
RUN chown spring:spring app.jar

# Switch to non-root user
USER spring:spring

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/clients || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
